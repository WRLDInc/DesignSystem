{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "styleguide/**",
              "ui_kits/_shared/**",
              "ui_kits/wrld-ai/**",
              "ui_kits/wrld-tech/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Ubuntu|Ubuntu Mono))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Ubuntu, Ubuntu Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentDetailAgent'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|icon|summary|status|runs|lastRun|description|key|ref|className|style|children)$/]",
        "message": "<AgentDetailAgent> doesn't accept that prop. Declared props: id, name, icon, summary, status, runs, lastRun, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentDetailAgent'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:healthy|degraded|off)$/]",
        "message": "<AgentDetailAgent> status must be one of 'healthy' | 'degraded' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Agent'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|icon|summary|status|runs|lastRun|description|key|ref|className|style|children)$/]",
        "message": "<Agent> doesn't accept that prop. Declared props: id, name, icon, summary, status, runs, lastRun, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='Agent'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:healthy|degraded|off)$/]",
        "message": "<Agent> status must be one of 'healthy' | 'degraded' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|warm)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'warm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:activeRoute|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: activeRoute, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:sub|theme|size|animated|style|key|ref|className|style|children)$/]",
        "message": "<Lockup> doesn't accept that prop. Declared props: sub, theme, size, animated, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Lockup> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunHistoryRun'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|summary|duration|time|key|ref|className|style|children)$/]",
        "message": "<RunHistoryRun> doesn't accept that prop. Declared props: status, summary, duration, time."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunHistoryRun'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:success|failed|running)$/]",
        "message": "<RunHistoryRun> status must be one of 'success' | 'failed' | 'running'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: active, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaPositive|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, delta, deltaPositive."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, subtitle."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
