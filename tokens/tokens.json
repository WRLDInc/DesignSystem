{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WRLD Design System",
    "version": "0.1.0",
    "updated": "2026-04-18",
    "owner": "WRLD Inc.",
    "canonical": "https://github.com/WRLDInc/DesignSystem"
  },
  "color": {
    "mono": {
      "0":   { "$value": "#ffffff", "$type": "color" },
      "50":  { "$value": "#fafafa", "$type": "color" },
      "100": { "$value": "#f4f4f5", "$type": "color" },
      "200": { "$value": "#e4e4e7", "$type": "color" },
      "300": { "$value": "#d4d4d8", "$type": "color" },
      "400": { "$value": "#a1a1aa", "$type": "color" },
      "500": { "$value": "#71717a", "$type": "color" },
      "600": { "$value": "#52525b", "$type": "color" },
      "700": { "$value": "#3f3f46", "$type": "color" },
      "800": { "$value": "#27272a", "$type": "color" },
      "900": { "$value": "#18181b", "$type": "color" },
      "950": { "$value": "#0a0a0a", "$type": "color", "$description": "Signature near-black — the anchoring WRLD color." }
    },
    "accent": {
      "primary":   { "$value": "#007fee", "$type": "color", "$description": "Interactive only — default hover/focus." },
      "secondary": { "$value": "#00adee", "$type": "color", "$description": "Interactive only — gradient companion." },
      "warm":      { "$value": "#EE9300", "$type": "color", "$description": "Interactive only — commerce CTA hover." }
    },
    "status": {
      "success": { "$value": "#10b981", "$type": "color" },
      "warning": { "$value": "#f59e0b", "$type": "color" },
      "danger":  { "$value": "#ef4444", "$type": "color" },
      "info":    { "$value": "#3b82f6", "$type": "color" }
    },
    "semantic": {
      "light": {
        "bg":          { "$value": "{color.mono.0}" },
        "bg-subtle":   { "$value": "{color.mono.50}" },
        "bg-muted":    { "$value": "{color.mono.100}" },
        "fg":          { "$value": "{color.mono.950}" },
        "fg-muted":    { "$value": "{color.mono.600}" },
        "fg-subtle":   { "$value": "{color.mono.500}" },
        "border":      { "$value": "{color.mono.200}" },
        "logo":        { "$value": "{color.mono.950}" }
      },
      "dark": {
        "bg":          { "$value": "{color.mono.950}" },
        "bg-subtle":   { "$value": "{color.mono.900}" },
        "bg-muted":    { "$value": "{color.mono.800}" },
        "fg":          { "$value": "{color.mono.50}" },
        "fg-muted":    { "$value": "{color.mono.400}" },
        "fg-subtle":   { "$value": "{color.mono.500}" },
        "border":      { "$value": "{color.mono.800}" },
        "logo":        { "$value": "{color.mono.0}" }
      }
    }
  },
  "typography": {
    "family": {
      "display":  { "$value": "Montserrat, 'Helvetica Neue', Arial, sans-serif", "$type": "fontFamily" },
      "body":     { "$value": "Ubuntu, system-ui, sans-serif", "$type": "fontFamily" },
      "body-alt": { "$value": "Ubuntu, system-ui, sans-serif", "$type": "fontFamily" },
      "mono":     { "$value": "'Ubuntu Mono', ui-monospace, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "display-xl": { "$value": "clamp(3rem, 2rem + 4vw, 6rem)",      "$type": "dimension" },
      "display-lg": { "$value": "clamp(2.25rem, 1.5rem + 3vw, 4.25rem)", "$type": "dimension" },
      "display-md": { "$value": "clamp(1.75rem, 1.25rem + 2vw, 3rem)",   "$type": "dimension" },
      "h1":      { "$value": "2.5rem",    "$type": "dimension" },
      "h2":      { "$value": "2rem",      "$type": "dimension" },
      "h3":      { "$value": "1.5rem",    "$type": "dimension" },
      "h4":      { "$value": "1.25rem",   "$type": "dimension" },
      "h5":      { "$value": "1.125rem",  "$type": "dimension" },
      "h6":      { "$value": "1rem",      "$type": "dimension" },
      "body-lg": { "$value": "1.125rem",  "$type": "dimension" },
      "body":    { "$value": "1rem",      "$type": "dimension" },
      "body-sm": { "$value": "0.875rem",  "$type": "dimension" },
      "caption": { "$value": "0.75rem",   "$type": "dimension" }
    },
    "lineHeight": {
      "display": { "$value": 1.05 },
      "heading": { "$value": 1.2 },
      "body":    { "$value": 1.6 },
      "ui":      { "$value": 1.4 }
    },
    "letterSpacing": {
      "display":  { "$value": "-0.02em" },
      "body":     { "$value": "0" },
      "eyebrow":  { "$value": "0.12em" },
      "caps-xl":  { "$value": "0.28em" }
    }
  },
  "space": {
    "0":  { "$value": "0",       "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.25rem", "$type": "dimension" },
    "6":  { "$value": "1.5rem",  "$type": "dimension" },
    "8":  { "$value": "2rem",    "$type": "dimension" },
    "10": { "$value": "2.5rem",  "$type": "dimension" },
    "12": { "$value": "3rem",    "$type": "dimension" },
    "16": { "$value": "4rem",    "$type": "dimension" },
    "20": { "$value": "5rem",    "$type": "dimension" },
    "30": { "$value": "7.5rem",  "$type": "dimension" }
  },
  "radius": {
    "0":    { "$value": "0",     "$type": "dimension" },
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "md":   { "$value": "8px",   "$type": "dimension" },
    "lg":   { "$value": "12px",  "$type": "dimension" },
    "pill": { "$value": "9999px","$type": "dimension" }
  },
  "border": {
    "hairline": { "$value": "1px", "$type": "dimension" },
    "standard": { "$value": "2px", "$type": "dimension" },
    "emphasis": { "$value": "3px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "micro":    { "$value": "120ms" },
      "default":  { "$value": "200ms" },
      "emphasis": { "$value": "320ms" },
      "reveal":   { "$value": "600ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
      "enter":    { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "precise":  { "$value": "cubic-bezier(0.83, 0, 0.17, 1)" }
    }
  },
  "breakpoint": {
    "sm":  { "$value": "640px" },
    "md":  { "$value": "768px" },
    "lg":  { "$value": "1024px" },
    "xl":  { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
